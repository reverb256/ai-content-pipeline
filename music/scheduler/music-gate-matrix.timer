# music/scheduler/music-gate-matrix.timer
# Daily timer for the music gate acceptance matrix (card t_b16b9046).
# Persistent: catches up on missed runs after downtime.
#
# 06:20 deliberately: the pipeline driver ticks at :00 and :30, policy-watch
# fires 07:00 and the oracle 08:00, so :20 keeps the (ffmpeg-heavy) matrix from
# piling onto another lane unit on the same host.

[Unit]
Description=Music Gate Matrix daily run (06:20)

[Timer]
OnCalendar=*-*-* 06:20:00
Persistent=true
AccuracySec=60s

[Install]
WantedBy=timers.target
