# music/scheduler/music-pipeline-driver.service
# systemd service unit — runs the pipeline driver for the music board.
# The driver walks the music kanban board and dispatches the owning bot
# per stage (brief → genre-select → lyrics → generate → curate → stems
# → master → gate → package → visual → publish → track).
#
# Timer: music-pipeline-driver.timer (every 30 min)
# Host: nexus (always-on)

[Unit]
Description=Music Pipeline Driver — walks the music board and dispatches stage bots
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /home/j_kro/ai-content-pipeline/scripts/automation/pipeline-driver.sh --board music
WorkingDirectory=/home/j_kro/ai-content-pipeline
# ---------------------------------------------------------------
# LIVE-DISPATCH GATE — t_41f354be section 4.
# Two mechanisms claim the music board: this driver (music/stages.yaml
# routes each stage to producer / writer / reviewer-deepseek / videobot /
# publishbot / analyst) and the generic kanban dispatcher (every oracle
# card is assigned music-producer). Arming both double-dispatches every
# card. Until j_kro settles who owns the board, the driver walks in
# dry-run: it resolves the card -> stage -> bot route and logs
# "[dry-run] would dispatch <bot>" without launching anything.
# DELETE this line (and this comment) only when section 4 is answered.
# ---------------------------------------------------------------
Environment=DRY_RUN=1
Environment=HOME=/home/j_kro
Nice=10
IOSchedulingClass=idle
# Timeout: 10 minutes — the driver should never hang
TimeoutStartSec=600
