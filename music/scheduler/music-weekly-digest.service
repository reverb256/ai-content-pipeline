# music/scheduler/music-weekly-digest.service
# systemd service unit — runs the weekly digest for the music lane.
# The digest collects: lane performance, oracle card outcomes, quota
# consumption, gate results, and platform policy changes.
#
# Timer: music-weekly-digest.timer (weekly, Monday 06:00)
# Host: nexus (always-on)

[Unit]
Description=Music Weekly Digest — weekly performance summary for the music lane
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'cd /home/j_kro/ai-content-pipeline && hermes -p analyst chat -q "Run the weekly music digest. Collect: (1) lane performance from performance/weekly/ for the music lane, (2) oracle card outcomes from the music kanban board, (3) quota consumption from music/quota-ledger.json, (4) the scheduled gate matrix: read performance/music-gate-matrix.log and performance/music-gate-matrix.status.json (music-gate-matrix.timer runs the acceptance suite for all 10 gates daily at 06:20; a non-zero rc in that status file is a gate defect and MUST be named in the digest, with the failing check lines — card t_b16b9046), (5) any platform policy changes detected by the music-policy-watch. Write the digest to performance/weekly/music-YYYY-WW.md. Post a summary card to the music kanban board." --oneshot -Q'
WorkingDirectory=/home/j_kro/ai-content-pipeline
Environment=HOME=/home/j_kro
Nice=10
IOSchedulingClass=idle
# TimeoutStartSec raised 600 -> 3600 (2026-10-16, t_75aacf8b). Same cause as
# music-policy-watch.service: the digest is a full analyst agent run over 5 data sources.
# Mon 2026-10-12 06:10:03 "start operation timed out. Terminating." -> result 'timeout',
# status=130. The job had NEVER completed once.
TimeoutStartSec=3600
